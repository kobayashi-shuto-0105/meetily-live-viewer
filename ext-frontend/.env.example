# =============================================================================
# Meetily External Web UI – environment variable template
# =============================================================================
#
# LOCAL DEVELOPMENT (default – no .env file needed)
# --------------------------------------------------
# The Vite dev server proxies /api, /health, and /ws to the Meetily backend
# on port 38391 automatically.  You do NOT need to create a .env file for
# local development unless you changed the backend port.
#
# Override the backend port only if you changed it:
#   VITE_BACKEND_PORT=38391
#
#
# LAN / REMOTE ACCESS
# -------------------
# When accessing the UI from another device on the LAN, the browser cannot
# use the Vite proxy. Set the following variables in a .env file:
#
#   VITE_MEETILY_API_BASE=http://<Meetily-PC-IP>:38391
#   VITE_MEETILY_WS_URL=ws://<Meetily-PC-IP>:38391/ws
#   VITE_MEETILY_ACCESS_TOKEN=<your-token>
#
# =============================================================================

# Backend port used by Vite proxy (local dev only, default 38391)
# VITE_BACKEND_PORT=38391

# Override API base URL (LAN / production only)
# VITE_MEETILY_API_BASE=http://127.0.0.1:38391

# Override WebSocket URL (LAN / production only)
# VITE_MEETILY_WS_URL=ws://127.0.0.1:38391/ws

# Access token – must match MEETILY_EXT_TOKEN on the Meetily side
# VITE_MEETILY_ACCESS_TOKEN=dev-token
