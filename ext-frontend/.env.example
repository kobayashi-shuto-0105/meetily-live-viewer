# =============================================================================
# External Web UI 環境変数テンプレート
# =============================================================================
# このファイルをコピーして .env を作成し、環境に合わせて値を変更する。
#   cp .env.example .env
#
# ローカル開発時はデフォルト値のまま使用可能。
# LAN 公開時は IP アドレスとトークンを変更する。
# =============================================================================

# Meetily External Web API のベース URL
# ローカル開発時: http://127.0.0.1:38391
# LAN 公開時: http://<Meetily実行PCのIP>:38391
VITE_MEETILY_API_BASE=http://127.0.0.1:38391

# WebSocket 接続先 URL
# ローカル開発時: ws://127.0.0.1:38391/ws
# LAN 公開時: ws://<Meetily実行PCのIP>:38391/ws
VITE_MEETILY_WS_URL=ws://127.0.0.1:38391/ws

# API アクセストークン（Meetily 側の MEETILY_EXT_TOKEN と一致させる）
# ローカル開発時: dev-token（Meetily 側未設定時のデフォルト）
# LAN 公開時: ランダムな長い文字列を設定する
VITE_MEETILY_ACCESS_TOKEN=dev-token
